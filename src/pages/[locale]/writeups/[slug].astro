---
import Article from '../../../layouts/Article.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection(
    'writeups',
    ({ data }) => !data.draft && (data.lang === 'ru' || data.lang === 'uz'),
  );
  return items.map((entry) => ({
    params: { locale: entry.data.lang, slug: entry.data.key },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---
<Article title={entry.data.title} summary={entry.data.summary} date={entry.data.date} cat={entry.data.cat} locale={entry.data.lang}>
  <Content />
</Article>
