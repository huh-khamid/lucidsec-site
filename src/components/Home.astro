---
import { getCollection } from 'astro:content';
import { content, basePath, localeNames, locales, type Locale } from '../i18n/content';
import { lid1, lid2, spiral } from '../lib/eye';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = content[locale];
const base = basePath(locale);

const nav = [
  { href: '#about', label: c.nav.about },
  { href: '#focus', label: c.nav.focus },
  { href: '#work', label: c.nav.work },
  { href: '#writeups', label: c.nav.writeups },
  { href: '#certs', label: c.nav.certs },
  { href: '#contact', label: c.nav.contact },
];

const writeups = (await getCollection('writeups', ({ data }) => !data.draft && data.lang === locale))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const leadRest = c.heroLead.replace('{name} ', '');
---
<header class="bar" id="bar">
  <div class="shell">
    <a class="mark" href={base + '/'} aria-label="LucidSec home">
      <svg viewBox="0 0 240 160" fill="none" stroke="#fff" stroke-width="12" stroke-linecap="round" stroke-linejoin="round">
        <path d={lid1} /><path d={lid2} /><path d={spiral} />
      </svg>
      <span><b>lucid</b><span class="sec">sec</span></span>
    </a>
    <div class="bar-right">
      <nav>{nav.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
      <div class="langs" aria-label="Language">
        {locales.map((l) => (
          <a href={basePath(l) + '/'} aria-current={l === locale ? 'true' : undefined}>{localeNames[l]}</a>
        ))}
      </div>
    </div>
  </div>
</header>

<main id="top">
  <!-- HERO -->
  <section class="hero" id="hero">
    <span class="ghost" aria-hidden="true">SEC</span>
    <span class="scan" id="scan"></span>
    <div class="shell">
      <svg class="eye" id="heroEye" viewBox="0 0 240 160" fill="none" stroke="#fff" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" aria-label="LucidSec eye mark">
        <path d={lid1} /><path d={lid2} /><path d={spiral} />
      </svg>
      <h1 class="wordmark" id="wm">LucidSec</h1>
      <p class="lead"><b>{c.heroName}</b> {leadRest}</p>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="about">
    <span class="ghost" aria-hidden="true">LOOK</span>
    <div class="shell">
      <p class="seclabel rv">{c.sec.about}</p>
      <div class="about-grid">
        <div>
          <p class="big rv"><Fragment set:html={c.about.slogan} /></p>
          <p class="body rv" style="margin-top:2rem">{c.about.body}</p>
        </div>
        <div class="meta rv">
          {c.about.meta.map((m) => (
            <div>{m.k} &nbsp; <span>{m.v}</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FOCUS -->
  <section id="focus">
    <div class="shell">
      <p class="seclabel rv">{c.sec.focus}</p>
      <div class="focus-list rv">
        {c.focus.map((f) => (
          <div class="focus-row">
            <span class="k">{f.k}</span>
            <span class="t">{f.t}</span>
            <span class="d">{f.d}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="work">
    <span class="ghost" aria-hidden="true" style="font-size:clamp(7rem,24vw,20rem); right:-2vw; top:8vh">WORK</span>
    <div class="shell">
      <div class="work-head">
        <div>
          <p class="seclabel rv" style="margin-bottom:1rem">{c.sec.selectedWork}</p>
          <p class="big rv">{c.big.work}</p>
        </div>
        <span class="drag-hint rv">{c.dragHint}</span>
      </div>

      <div class="track" id="track">
        {c.cases.map((cs) => (
          <article class="case">
            <div class="case-top"><span>{cs.tag}</span><span>{cs.stack}</span></div>
            <h3>{cs.title}</h3>
            <p class="sum">{cs.sum}</p>
            <p class="stat">{cs.stat}</p>
            <div class="findings">{cs.findings.map((f) => <span class="f">{f}</span>)}</div>
          </article>
        ))}
      </div>
      <p class="note">{c.caseNote}</p>
    </div>
  </section>

  <!-- WRITEUPS -->
  <section id="writeups">
    <div class="shell">
      <p class="seclabel rv">{c.sec.writeups}</p>
      <p class="big rv">{c.big.writeups}</p>
      <div class="wlist rv">
        {writeups.map((w) => (
          <a class="wrow" href={`${base}/writeups/${w.data.key}`}>
            <span class="date">{w.data.date.getFullYear()}</span>
            <span class="title">{w.data.title}</span>
            <span class="cat">{w.data.cat}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CERTIFICATIONS -->
  <section id="certs">
    <div class="shell">
      <p class="seclabel rv">{c.sec.certs}</p>
      <p class="big rv">{c.big.certs}</p>
      <div class="certs-grid rv">
        {c.certsList.map((ct) => (
          <div class="cert">
            <span class="badge">{ct.badge}</span>
            <h3>{ct.title}</h3>
            <span class="issuer">{ct.issuer}</span>
            <span class="cmeta">{ct.year}</span>
            {ct.verify && <a class="verify" href={ct.verify} target="_blank" rel="noopener">{c.verify}</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact">
    <div class="shell">
      <p class="seclabel rv">{c.sec.contact}</p>
      <p class="cta rv">{c.contact.ctaLine1}<br />{c.contact.ctaLine2}</p>
      <div class="cta-actions rv">
        <a class="mailbtn" href="mailto:hello@lucidsec.uz">hello@lucidsec.uz →</a>
        <div class="socials">
          <a href="https://github.com/huh-khamid" target="_blank" rel="noopener">GitHub</a><a href="https://t.me/LucidSec_uz" target="_blank" rel="noopener">Telegram</a><a href="https://instagram.com/lucidsec.uz" target="_blank" rel="noopener">Instagram</a>
        </div>
      </div>
      <div class="foot">
        <span>© 2026 LucidSec · lucidsec.uz</span>
        <svg class="eye-sm" viewBox="0 0 240 160" fill="none" stroke="#8c8c8c" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={lid1} /><path d={lid2} /><path d={spiral} />
        </svg>
        <span>{c.footerTagline}</span>
      </div>
    </div>
  </section>
</main>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const bar = document.getElementById('bar');
  const onScroll = () => bar && bar.classList.toggle('scrolled', window.scrollY > 20);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  if (!reduce) {
    const eye = document.getElementById('heroEye');
    if (eye) {
      eye.querySelectorAll('path').forEach((p, i) => {
        const len = p.getTotalLength();
        p.style.strokeDasharray = String(len);
        p.style.strokeDashoffset = String(len);
        p.style.transition = `stroke-dashoffset 1.1s cubic-bezier(.65,0,.35,1) ${0.15 + i * 0.22}s`;
        requestAnimationFrame(() => requestAnimationFrame(() => { p.style.strokeDashoffset = '0'; }));
      });
    }
    const wm = document.getElementById('wm');
    if (wm) {
      wm.style.clipPath = 'inset(0 100% 0 0)';
      wm.style.transition = 'clip-path 1s cubic-bezier(.76,0,.24,1) 0.9s';
      requestAnimationFrame(() => requestAnimationFrame(() => { wm.style.clipPath = 'inset(0 0 0 0)'; }));
    }
    const scan = document.getElementById('scan');
    if (scan) {
      setTimeout(() => {
        scan.style.transition = 'top 1.1s ease, opacity .2s';
        scan.style.opacity = '1'; scan.style.top = '12%';
        requestAnimationFrame(() => { scan.style.top = '88%'; });
        setTimeout(() => { scan.style.opacity = '0'; }, 1100);
      }, 1500);
    }
  }

  const io = new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.rv').forEach((el) => io.observe(el));

  const track = document.getElementById('track');
  if (track) {
    let down = false, startX = 0, startScroll = 0, moved = 0;
    track.addEventListener('pointerdown', (e) => {
      down = true; moved = 0; startX = e.clientX; startScroll = track.scrollLeft;
      track.classList.add('dragging'); track.setPointerCapture(e.pointerId);
    });
    track.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX; moved = Math.abs(dx);
      track.scrollLeft = startScroll - dx;
    });
    const end = () => { down = false; track.classList.remove('dragging'); };
    track.addEventListener('pointerup', end);
    track.addEventListener('pointercancel', end);
    track.querySelectorAll('a,article').forEach((el) =>
      el.addEventListener('click', (e) => { if (moved > 6) e.preventDefault(); }));
  }
</script>
